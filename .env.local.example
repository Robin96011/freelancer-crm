# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Must match the site URL you use in the browser (no trailing slash).
# Supabase → Authentication → URL Configuration:
#   Site URL: same value (e.g. http://localhost:3000)
#   Redirect URLs: include http://localhost:3000/auth/callback
#     (and production URL + /auth/callback when you deploy)
#
# Vercel production: set NEXT_PUBLIC_APP_URL to https://YOUR-PROJECT.vercel.app
# (or your custom domain). Add the same origin + /auth/callback in Supabase
# Redirect URLs. See DEPLOY.md.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Step 3+ (placeholders)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Anthropic (https://console.anthropic.com/) — server-only, never exposed to the browser
ANTHROPIC_API_KEY=
# Optional override (default: claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=
RESEND_API_KEY=
